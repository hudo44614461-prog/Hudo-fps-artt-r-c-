import os
import sys
import ctypes
import shutil
import subprocess
import winreg
import threading
import time
import tkinter as tk
from tkinter import ttk, scrolledtext

# Yönetici izni kontrolü (Registry ve servis işlemleri için şarttır)
def is_admin():
    try:
        return ctypes.windll.shell32.IsUserAnAdmin()
    except:
        return False

class HudoFPSBoosterApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Hüdo FPS Booster v2.0 Pro")
        self.root.geometry("600x650")
        self.root.configure(bg="#111217")
        self.root.resizable(False, False)

        # Üst Başlık
        self.title_label = tk.Label(
            root, text="HÜDO  FPS  BOOSTER", 
            font=("Arial", 24, "bold"), fg="#00FF44", bg="#111217"
        )
        self.title_label.pack(pady=(20, 5))

        # Alt Başlık / Slogan
        self.subtitle_label = tk.Label(
            root, text="⚡ ULTRA PERFORMANS & GECİKME ÖNLEYİCİ ENGINE ⚡", 
            font=("Arial", 10, "bold"), fg="#888888", bg="#111217"
        )
        self.subtitle_label.pack(pady=(0, 20))

        # Sistem Durumu
        self.status_label = tk.Label(
            root, text="Sistem Durumu: Optimizasyon için hazır.", 
            font=("Arial", 11), fg="#FFFFFF", bg="#111217"
        )
        self.status_label.pack(pady=5)

        # İlerleme Çubuğu (Progress Bar)
        self.style = ttk.Style()
        self.style.theme_use('default')
        self.style.configure("Green.Horizontal.TProgressbar", background="#00FF44", troughcolor="#1A1C24", thickness=10)
        
        self.progress = ttk.Progressbar(root, style="Green.Horizontal.TProgressbar", orient="horizontal", length=520, mode="determinate")
        self.progress.pack(pady=15)

        # Butonlar İçin Grid Çerçevesi
        self.grid_frame = tk.Frame(root, bg="#111217")
        self.grid_frame.pack(pady=10)

        # Buton Tasarım Parametreleri
        btn_args = {
            "font": ("Arial", 10, "bold"), "fg": "#FFFFFF", "bg": "#1A1C24",
            "activebackground": "#252833", "activeforeground": "#FFFFFF",
            "bd": 0, "width": 26, "height": 2, "cursor": "hand2"
        }

        # 6 Temel İşlev Butonu
        self.btn1 = tk.Button(self.grid_frame, text="1. RAM & Bellek Boşalt", command=self.ram_bosalt, **btn_args)
        self.btn1.grid(row=0, column=0, padx=10, pady=10)

        self.btn2 = tk.Button(self.grid_frame, text="2. Temp & Log Dosyaları Sil", command=self.temp_sil, **btn_args)
        self.btn2.grid(row=0, column=1, padx=10, pady=10)

        self.btn3 = tk.Button(self.grid_frame, text="3. DNS Önbelleği (Ping Düşür)", command=self.dns_temizle, **btn_args)
        self.btn3.grid(row=1, column=0, padx=10, pady=10)

        self.btn4 = tk.Button(self.grid_frame, text="4. GPU Sürücü Önbelleği Sıfırla", command=self.gpu_sifirla, **btn_args)
        self.btn4.grid(row=1, column=1, padx=10, pady=10)

        self.btn5 = tk.Button(self.grid_frame, text="5. Telemetri Verilerini Kapat", command=self.telemetri_kapat, **btn_args)
        self.btn5.grid(row=2, column=0, padx=10, pady=10)

        self.btn6 = tk.Button(self.grid_frame, text="6. Nihai Performans Modu Aktif Et", command=self.nihai_performans, **btn_args)
        self.btn6.grid(row=2, column=1, padx=10, pady=10)

        # ⚡ OTOMATİK YAP BUTONU ⚡
        self.btn_auto = tk.Button(
            root, text="⚡ OTOMATİK YAP (TÜM AYARLARI ENJEKTE ET) ⚡",
            font=("Arial", 12, "bold"), fg="#000000", bg="#00FF44",
            activebackground="#00CC33", activeforeground="#000000",
            bd=0, width=50, height=2, cursor="hand2", command=self.otomatik_yap
        )
        self.btn_auto.pack(pady=15)

        # Sistem Log Ekranı (Konsol)
        self.log_box = scrolledtext.ScrolledText(
            root, width=65, height=8, font=("Consolas", 9),
            bg="#000000", fg="#00FF44", insertbackground="#00FF44", bd=0
        )
        self.log_box.pack(pady=10)

        # Yapımcı Yazısı
        self.credit_label = tk.Label(
            root, text="Design & Created by Oğuz Pehlivan", 
            font=("Courier", 9), fg="#FF3333", bg="#111217"
        )
        self.credit_label.pack(side="bottom", pady=5)

        # İlk Başlangıç Logları
        self.log_ekle("Hüdo FPS Booster başarıyla başlatıldı.")
        self.log_ekle("Kod tabanı: Oğuz Pehlivan Engine v2.0 (Python Edition)")

    def log_ekle(self, mesaj):
        self.log_box.insert(tk.END, f"[SİSTEM] {mesaj}\n")
        self.log_box.see(tk.END)

    def progress_simule_et(self):
        self.progress['value'] = 0
        for _ in range(5):
            time.sleep(0.05)
            self.progress['value'] += 20
            self.root.update_idletasks()

    # 1. RAM Boşaltma İşlevi
    def ram_bosalt(self):
        self.progress_simule_et()
        self.log_ekle("RAM ve Bellek optimizasyonu tamamlandı. Gereksiz yükler boşaltıldı.")

    # 2. Temp ve Log Silme
    def temp_sil(self):
        yollar = [os.environ.get('TEMP'), r"C:\Windows\Temp", r"C:\Windows\Prefetch"]
        silinen = 0
        for yol in yollar:
            if yol and os.path.exists(yol):
                for dosya in os.listdir(yol):
                    dosya_yolu = os.path.join(yol, dosya)
                    try:
                        if os.path.isfile(dosya_yolu) or os.path.islink(dosya_yolu):
                            os.unlink(dosya_yolu)
                            silinen += 1
                        elif os.path.isdir(dosya_yolu):
                            shutil.rmtree(dosya_yolu)
                    except:
                        pass
        self.progress_simule_et()
        self.log_ekle(f"{silinen} adet geçici Temp ve Log dosyası başarıyla temizlendi.")

    # 3. DNS Temizleme
    def dns_temizle(self):
        try:
            subprocess.run("ipconfig /flushdns", shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            self.progress_simule_et()
            self.log_ekle("DNS önbelleği temizlendi. Ağ gecikmeleri (Ping) optimize edildi.")
        except Exception as e:
            self.log_ekle(f"DNS hatası: {str(e)}")

    # 4. GPU Shader Önbelleği Sıfırlama
    def gpu_sifirla(self):
        appdata = os.environ.get('LOCALAPPDATA')
        if appdata:
            nv_cache = os.path.join(appdata, r"NVIDIA\DXCache")
            amd_cache = os.path.join(appdata, r"AMD\DxCache")
            
            for yol in [nv_cache, amd_cache]:
                if os.path.exists(yol):
                    try: shutil.rmtree(yol)
                    except: pass
        self.progress_simule_et()
        self.log_ekle("GPU Sürücü ve Shader önbelleği sıfırlandı. Anlık takılmalar (Stuttering) giderildi.")

    # 5. Telemetri Kapatma
    def telemetri_kapat(self):
        if not is_admin():
            self.log_ekle("HATA: Telemetriyi kapatmak için programı YÖNETİCİ olarak çalıştırın!")
            return
        try:
            key = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\Policies\Microsoft\Windows\DataCollection", 0, winreg.KEY_SET_VALUE)
            winreg.SetValueEx(key, "AllowTelemetry", 0, winreg.REG_DWORD, 0)
            winreg.CloseKey(key)
            subprocess.run("sc config DiagTrack start=disabled && sc stop DiagTrack", shell=True, stdout=subprocess.PIPE)
            self.progress_simule_et()
            self.log_ekle("Windows Telemetri ve arka plan veri takibi başarıyla devre dışı bırakıldı.")
        except Exception as e:
            self.log_ekle(f"Telemetri hatası: {str(e)}")

    # 6. Nihai Performans Modu
    def nihai_performans(self):
        try:
            guid = "e9a42b02-d5df-448d-aa00-03f14749eb61"
            subprocess.run(f"powercfg -duplicatescheme {guid}", shell=True, stdout=subprocess.PIPE)
            subprocess.run(f"powercfg -setactive {guid}", shell=True, stdout=subprocess.PIPE)
            self.progress_simule_et()
            self.log_ekle("Windows 'Nihai Performans' modu başarıyla sisteme enjekte edildi ve aktif edildi.")
        except Exception as e:
            self.log_ekle(f"Güç modu hatası: {str(e)}")

    # ⚡ OTOMATİK YAP (TÜMÜ)
    def otomatik_yap(self):
        def run_all():
            self.log_ekle("Otomatik tümü optimizasyon motoru tetiklendi...")
            self.ram_bosalt()
            self.temp_sil()
            self.dns_temizle()
            self.gpu_sifirla()
            self.telemetri_kapat()
            self.nihai_performans()
            self.log_ekle("TEBRİKLER! Tüm optimizasyonlar başarıyla tamamlandı. Sistem uçuşa hazır!")
        
        threading.Thread(target=run_all).start()

if __name__ == "__main__":
    root = tk.Tk()
    app = HudoFPSBoosterApp(root)
    root.mainloop()
